root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches taplo.toml.
[*.toml]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

# A trailing double space is a Markdown line break.
[*.md]
trim_trailing_whitespace = false
