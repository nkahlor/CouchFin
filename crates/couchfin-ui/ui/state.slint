import { RowData } from "browse-state.slint";
import { Placeholders } from "placeholder.slint";

// The data each screen renders and the requests it sends back. The binding
// in src/bind.rs sets these from couchfin-core's LoginScreen and turns the
// callbacks into core's actions; the screens hold no logic beyond focus and
// key handling. Wording is the UI's: properties carry data or messages that
// src/wording.rs chose, never error codes.

// Which screen MainWindow shows.
export enum Screen {
    // Starting up, or checking a stored session.
    connecting,
    // Checking a stored session failed; offers Retry and Change server.
    connect-failed,
    // Type the server's address.
    address,
    // Sign in to the server that the address check found.
    login,
    // Signed in: rows of cards.
    home,
    // A library's grid of posters.
    library,
    // A movie's detail page.
    movie,
    // A series' detail page.
    series,
}

// The startup screens: connecting, and why connecting failed.
export global ConnectView {
    // The stored server's address; empty before it is known.
    in property <string> server;
    // Why connecting failed, on connect-failed.
    in property <string> error;
    // Try the stored session again.
    callback retry();
    // Type another address.
    callback change-server();
    // Back (Escape, or Backspace on a button).
    callback back();
}

// The server address screen.
export global AddressView {
    // What is in the address field. The user's typing updates it, and the
    // app may set it to prefill a previous address.
    in-out property <string> address;
    // True while the address is being checked: shows progress, and the field
    // and Connect ignore input until it is false again.
    in property <bool> busy;
    // A message for the user, shown under the field; empty shows none.
    in property <string> error;
    // Connect (or Enter in the field) with the address as typed.
    callback submit(address: string);
    // Back (Escape) on this screen.
    callback back();
}

// The username and password screen.
export global LoginView {
    // The name the server's admin gave it, from /System/Info/Public.
    in property <string> server-name;
    // The canonical address the login goes to (after any redirects), shown
    // before the password is typed so a redirect to another host is visible.
    in property <string> server-address;
    // What is in the username field; typing updates it, the app may prefill.
    in-out property <string> username;
    // True while signing in: shows progress and ignores input and submit.
    in property <bool> busy;
    // A message for the user, shown under the form; empty shows none.
    in property <string> error;
    // Each change empties the password field and focuses it. The binding
    // bumps it on every failed sign-in, since core never holds the password.
    in property <int> password-resets;
    // Sign in (or Enter in the password field). The password exists only in
    // the field and in this callback's argument; no property holds it.
    callback submit(username: string, password: string);
    // Change server (or Escape): go back to the address screen.
    callback back();
}

// The home screen: the server, who is signed in, rows of cards and Sign out.
export global HomeView {
    // The server's name, from /System/Info/Public.
    in property <string> server-name;
    // The server's Jellyfin version, such as 10.11.2.
    in property <string> server-version;
    // The signed-in user's name, from /Users/Me.
    in property <string> username;
    // A quiet note under the details, such as a sign-in that couldn't be
    // saved; empty shows none.
    in property <string> notice;
    // The rows, top to bottom. Core never sends a row without cards, so every
    // row here is drawn. In-out because each row's `current` is written as the
    // user moves. Placeholders until the app binds the library.
    in-out property <[RowData]> rows: Placeholders.home-rows;
    // The row with focus, and also the row last focused while Sign out has
    // it. These three live here, not in the page, so Home comes back where
    // it was after a detail page, and the app can keep them right when rows
    // arrive above the focused one.
    in-out property <int> focused-row: 0;
    // How many rows of each shape are scrolled out above the focused one.
    // Counted, not measured, so a resize keeps the anchor.
    in-out property <int> posters-above: 0;
    in-out property <int> thumbs-above: 0;
    // The height a poster has in a row, as the page lays it out, so the app
    // can ask for pictures of the right size. 0 before the first layout.
    in-out property <length> poster-height;
    // Shown in place of the rows while there are none: loading, the reason a
    // load failed, or that the library is empty.
    in property <string> status;
    // A row failed to load; shown beside the notice. Empty shows none.
    in property <string> error;
    // Enter on a card, with its row and its place in the row (0 is the
    // first of each).
    callback card-activated(row: int, index: int);
    // Focus moved: it is now on this card of this row. Fires for moves along
    // a row and between rows, so core can remember each row's card.
    callback focus-changed(row: int, index: int);
    // The Sign out button.
    callback sign-out();
    // Back (Escape or Backspace).
    callback back();
}
