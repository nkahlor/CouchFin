// Colours and sizes for a 10-foot UI: read from a sofa, on a TV, with only
// focus to show where you are. The background matches the Hello window.
export global Theme {
    out property <color> background: #101418;
    out property <color> surface: #1c232b;
    out property <color> text: #f0f0f0;
    out property <color> muted: #a9b4bf;
    // The focus highlight: a thick, bright ring that reads at TV distance.
    out property <color> focus: #4fc3f7;
    out property <color> on-focus: #0b1a22;
    out property <color> error: #ff8a80;

    out property <length> title-size: 72px;
    out property <length> body-size: 40px;
    out property <length> label-size: 32px;
    out property <length> focus-ring: 6px;
    out property <length> radius: 12px;
    out property <length> spacing: 24px;
    // Wide enough for a long https:// address at body size.
    out property <length> form-width: 1200px;
}
