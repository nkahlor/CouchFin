import { Theme } from "../theme.slint";
import { CardShape } from "../browse-state.slint";

// A card with its title underneath: a 2:3 poster or a 16:9 thumbnail (which
// can also carry a progress bar and a subtitle). It takes no focus itself:
// the row or grid it sits in holds focus and says which card is current and
// which it has passed, so moving is one property change, and the row
// remembers its place while focus is elsewhere.
//
// The card's own size is its slot. The active card's picture grows past the
// slot, about its centre, so neighbours never move.
export component Card inherits Rectangle {
    in property <string> title;
    // A thumbnail's second line, such as "S2 · E4"; empty shows none.
    in property <string> subtitle;
    in property <CardShape> shape: CardShape.poster;
    // Resume progress from 0 to 1; 0 or less shows no bar.
    in property <float> progress;
    // The picture's height at rest; the width follows from the shape.
    in property <length> image-height;
    // The picture; empty for the placeholder look.
    in property <image> image;
    // The card the row or grid last focused, whether or not it has focus.
    in property <bool> current;
    // Current in a focused row: larger, ringed and glowing.
    in property <bool> highlighted;
    // Left of the row's current card: shaded, with a dimmer title.
    in property <bool> passed;
    // Its place in the row, and the row's length, for screen readers.
    in property <int> index;
    in property <int> count;

    // Enter while highlighted, a click, or a screen reader's default action.
    callback activated();

    property <length> image-width: root.image-height * (root.shape == CardShape.poster ? Theme.poster-aspect : Theme.thumb-aspect);
    property <float> grow: root.highlighted ? Theme.card-active-scale : 1;
    animate grow {
        duration: Theme.focus-duration;
        easing: ease-out;
    }

    width: self.image-width;
    height: root.image-height + Theme.card-title-gap + Theme.card-title-height + (root.shape == CardShape.thumb ? Theme.card-subtitle-height : 0);

    accessible-role: list-item;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    accessible-action-default => {
        root.activated();
    }

    poster := Rectangle {
        width: root.image-width * root.grow;
        height: root.image-height * root.grow;
        x: (root.image-width - self.width) / 2;
        y: (root.image-height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius;
        drop-shadow-color: root.highlighted ? Theme.card-glow : Theme.card-glow.with-alpha(0);
        drop-shadow-blur: Theme.card-glow-blur;
        animate drop-shadow-color { duration: Theme.focus-duration; }

        Rectangle {
            border-radius: Theme.radius;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.image;
                image-fit: cover;
                accessible-role: none;
            }

            shade := Rectangle {
                background: Theme.passed-card-shade;
                opacity: root.passed ? 1 : 0;
                animate opacity { duration: Theme.focus-duration; }
            }

            if root.progress > 0: progress-bar := Rectangle {
                y: parent.height - Theme.progress-height;
                height: Theme.progress-height;
                background: Theme.progress-track;

                progress-fill := Rectangle {
                    width: parent.width * clamp(root.progress, 0, 1);
                    background: Theme.focus;
                }
            }
        }

        // Over the picture, so an image never covers it.
        ring := Rectangle {
            border-radius: Theme.radius;
            border-width: Theme.card-active-ring;
            border-color: Theme.focus;
            opacity: root.highlighted ? 1 : 0;
            animate opacity { duration: Theme.focus-duration; }
        }
    }

    title := Text {
        y: poster.y + poster.height + Theme.card-title-gap;
        height: Theme.card-title-height;
        text: root.title;
        color: root.highlighted ? Theme.text : root.passed ? Theme.passed-title : Theme.muted;
        animate color { duration: Theme.focus-duration; }
        font-size: Theme.label-size;
        font-weight: root.highlighted ? Theme.strong-weight : Theme.regular-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        // The card itself carries the title.
        accessible-role: none;
    }

    if root.shape == CardShape.thumb: Text {
        y: title.y + Theme.card-title-height;
        height: Theme.card-subtitle-height;
        text: root.subtitle;
        color: root.passed ? Theme.passed-title : Theme.muted;
        font-size: Theme.label-size;
        font-weight: Theme.regular-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    TouchArea {
        clicked => {
            root.activated();
        }
    }
}
