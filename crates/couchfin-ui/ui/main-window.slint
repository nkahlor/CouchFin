import { Theme } from "theme.slint";
import {
    Screen,
    ConnectView,
    AddressView,
    LoginView,
    HomeView,
} from "state.slint";
import {
    LibraryView,
    MovieView,
    SeriesView,
    CardData,
    CardShape,
    RowData,
    EpisodeData,
} from "browse-state.slint";
import { ConnectingPage, ConnectFailedPage } from "screens/connect.slint";
import { AddressPage } from "screens/address.slint";
import { HomePage } from "screens/home.slint";
import { LibraryPage } from "screens/library.slint";
import { MoviePage } from "screens/movie.slint";
import { SeriesPage } from "screens/series.slint";
import { LoginPage } from "screens/login.slint";

export {
    Screen,
    ConnectView,
    AddressView,
    LoginView,
    HomeView,
    LibraryView,
    MovieView,
    SeriesView,
    CardData,
    CardShape,
    RowData,
    EpisodeData,
}

// The one window Couchfin shows. Only the current screen exists: switching
// destroys the previous one (and anything typed into it, such as a
// password), and the new one focuses its first control.
export component MainWindow inherits Window {
    in property <Screen> screen: Screen.connecting;
    // What Back means on the current screen: quit, or (false) change
    // server. src/bind.rs sets it from core's state and reads it on Back.
    in property <bool> back-quits: true;

    // Offered every key before the focused control sees it, as its text and
    // whether it is an auto-repeat. Returns true to swallow a duplicate
    // (src/navigator.rs; decision 013). Unset, nothing is swallowed.
    callback filter-key(string, bool) -> bool;

    title: "Couchfin";
    background: Theme.background;

    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if root.filter-key(event.text, event.repeat) {
                return EventResult.accept;
            }
            EventResult.reject
        }

        if root.screen == Screen.connecting: ConnectingPage { }
        if root.screen == Screen.connect-failed: ConnectFailedPage { }
        if root.screen == Screen.address: AddressPage { }
        if root.screen == Screen.login: LoginPage { }
        if root.screen == Screen.home: HomePage { }
        if root.screen == Screen.library: LibraryPage { }
        if root.screen == Screen.movie: MoviePage { }
        if root.screen == Screen.series: SeriesPage { }
    }
}
