import { Theme } from "../theme.slint";
import { HomeScreen } from "../state.slint";
import { Keys, KeyIntent } from "../widgets/keys.slint";

// Phase 1's home: which server, which version, who is signed in. It has no
// controls yet, so the page itself holds focus to catch Back.
export component HomePage inherits FocusScope {
    init => {
        self.focus();
    }

    key-pressed(event) => {
        if Keys.intent(event) == KeyIntent.back || Keys.intent(event) == KeyIntent.backspace {
            HomeScreen.back();
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing;

        Text {
            text: HomeScreen.server-name;
            color: Theme.text;
            font-size: Theme.title-size;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "Jellyfin " + HomeScreen.server-version;
            color: Theme.muted;
            font-size: Theme.body-size;
            horizontal-alignment: center;
        }

        Text {
            text: "Signed in as " + HomeScreen.username;
            color: Theme.text;
            font-size: Theme.body-size;
            horizontal-alignment: center;
        }
    }
}
