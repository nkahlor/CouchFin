import { Theme } from "../theme.slint";
import { HomeView } from "../state.slint";
import { Button } from "../widgets/button.slint";
import { Card } from "../widgets/card.slint";
import { Keys, KeyIntent } from "../widgets/keys.slint";

// Home: which server and who is signed in, a carousel of title cards, and
// Sign out. The row takes focus on arrival, so an Enter still held from
// signing in selects a card rather than pressing Sign out.
//
// Focus map: Left and Right step through the row and stop at its ends; the
// current card stays in one slot and the row slides under it. Down (or Tab)
// goes to Sign out; Up (or Shift+Tab) comes back to the card you left.
// Escape or Backspace anywhere asks to go back.
export component HomePage inherits Rectangle {
    // Placeholders until Phase 3 fills the row from the library.
    property <[string]> titles: [
        "Title 1",
        "Title 2",
        "Title 3",
        "Title 4",
        "Title 5",
        "Title 6",
        "Title 7",
        "Title 8",
        "Title 9",
        "Title 10",
    ];
    // The last card selected, or -1. Only shown, until there is a detail
    // page to open.
    property <int> selected: -1;

    init => {
        row.focus();
    }

    function activate(index: int) {
        root.selected = index;
        HomeView.card-activated(index);
    }

    VerticalLayout {
        padding: Theme.page-margin;
        spacing: Theme.spacing;
        alignment: center;

        HorizontalLayout {
            spacing: Theme.spacing;

            VerticalLayout {
                alignment: end;

                Text {
                    text: HomeView.server-name;
                    color: Theme.text;
                    font-size: Theme.title-size;
                    font-weight: Theme.strong-weight;
                    overflow: elide;
                }

                Text {
                    text: "Jellyfin " + HomeView.server-version;
                    color: Theme.muted;
                    font-size: Theme.label-size;
                }
            }

            VerticalLayout {
                alignment: end;

                Text {
                    text: "Signed in as " + HomeView.username;
                    color: Theme.text;
                    font-size: Theme.body-size;
                    horizontal-alignment: right;
                }

                // Always takes its line, so the row never jumps when it
                // appears.
                Text {
                    text: root.selected < 0 ? "" : "Selected: " + root.titles[root.selected];
                    color: Theme.muted;
                    font-size: Theme.label-size;
                    horizontal-alignment: right;
                }
            }
        }

        row := FocusScope {
            property <int> current: 0;
            property <int> count: root.titles.length;
            // A card's height beyond its poster, with room for it to grow.
            property <length> around-poster: 2 * Theme.card-focus-room + Theme.card-title-gap + Theme.card-title-height;
            // The room the screen leaves decides the poster's size.
            property <length> poster-height: clamp(
                self.height - self.around-poster,
                Theme.poster-min-height,
                Theme.poster-max-height);
            // One card and the gap after it: how far the row slides per step.
            property <length> slot: self.poster-height * Theme.poster-aspect + Theme.card-gap;

            // Set here rather than from the cards, whose size follows the
            // row's: the row takes what the screen leaves, within these.
            min-height: Theme.poster-min-height + self.around-poster;
            preferred-height: Theme.poster-max-height + self.around-poster;
            max-height: self.preferred-height;
            vertical-stretch: 1;
            accessible-role: list;

            key-pressed(event) => {
                if Keys.intent(event) == KeyIntent.left {
                    self.current = max(0, self.current - 1);
                    return accept;
                }
                if Keys.intent(event) == KeyIntent.right {
                    self.current = min(self.count - 1, self.current + 1);
                    return accept;
                }
                if Keys.intent(event) == KeyIntent.next {
                    sign-out.focus();
                    return accept;
                }
                if Keys.intent(event) == KeyIntent.activate {
                    root.activate(self.current);
                    return accept;
                }
                if Keys.intent(event) == KeyIntent.back || Keys.intent(event) == KeyIntent.backspace {
                    HomeView.back();
                    return accept;
                }
                return reject;
            }

            // The carousel: the current card always sits in the slot at
            // Theme.carousel-inset, and the row slides under it, one slot per
            // step, to the very last card. `current` changes at once and only
            // the slide animates, so a held D-pad retargets it mid-way rather
            // than waiting. It runs from the screen's left edge, past the page
            // margin, so the card before the current one is cut off by the
            // edge of the screen. A Flickable rather than a clipping
            // Rectangle, so screen readers still list the cards out of view.
            Flickable {
                x: -Theme.page-margin;
                width: parent.width + 2 * Theme.page-margin;
                interactive: false;
                content-width: Theme.carousel-inset + row.count * row.slot + self.width;
                content-x: -row.current * row.slot;
                animate content-x {
                    duration: Theme.scroll-duration;
                    easing: ease-out;
                }

                for title[index] in root.titles: Card {
                    x: Theme.carousel-inset + index * row.slot;
                    y: Theme.card-focus-room;
                    title: title;
                    poster-height: row.poster-height;
                    current: index == row.current;
                    highlighted: row.has-focus && index == row.current;
                    passed: index < row.current;
                    index: index;
                    count: row.count;
                    activated => {
                        row.current = index;
                        row.focus();
                        root.activate(index);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing;

            sign-out := Button {
                width: Theme.button-width;
                text: "Sign out";
                clicked => {
                    HomeView.sign-out();
                }
                move-previous => {
                    row.focus();
                }
                back => {
                    HomeView.back();
                }
            }

            if HomeView.notice != "": Text {
                text: HomeView.notice;
                color: Theme.muted;
                font-size: Theme.label-size;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
