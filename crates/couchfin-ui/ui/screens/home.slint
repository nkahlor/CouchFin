import { Theme } from "../theme.slint";
import { HomeView } from "../state.slint";
import { CardShape } from "../browse-state.slint";
import { Button } from "../widgets/button.slint";
import { CarouselRow, CarouselMetrics } from "../widgets/carousel.slint";
import { Keys, KeyIntent } from "../widgets/keys.slint";

// Home: which server and who is signed in, a vertical stack of carousel
// rows, and Sign out. The rows take focus on arrival, on the first card of
// the first row, so an Enter still held from signing in selects a card
// rather than signing out (decisions 011 and 015).
//
// Focus map: Left and Right step through the focused row and stop at its
// ends. Down (or Tab) moves to the row below, which keeps its own card;
// Down from the bottom row reaches Sign out. Up (or Shift+Tab) goes back the
// same way, and does nothing on the first row. The page scrolls so the
// focused row always sits at Theme.home-row-anchor. Left and Right on Sign
// out do nothing. Escape or Backspace anywhere asks to go back.
export component HomePage inherits Rectangle {
    // The row with focus, and also the row last focused while Sign out has
    // it. -1 when no row has cards.
    property <int> focused-row: root.below(-1);
    // How many rows of each shape are scrolled out above the focused one.
    // Counted, not measured, so a resize keeps the anchor.
    property <int> posters-above: 0;
    property <int> thumbs-above: 0;
    // The last card selected. Only shown, until there is a detail page.
    property <string> selected;

    // The height a poster has: what the viewport leaves after a poster row's
    // fixed parts, between its limits.
    property <length> poster-height: clamp(
        viewport.height - CarouselMetrics.height(CardShape.poster, 0px),
        Theme.home-poster-min-height,
        Theme.poster-max-height);
    property <length> scroll: root.posters-above * CarouselMetrics.height(CardShape.poster, root.poster-height) + root.thumbs-above * CarouselMetrics.height(CardShape.thumb, root.poster-height);

    init => {
        scope.focus();
    }

    function usable(row: int) -> bool {
        row >= 0 && row < HomeView.rows.length && HomeView.rows[row].cards.length > 0
    }

    // The next row with cards, stepping over up to two empty ones; -1 if
    // there is none.
    function below(from: int) -> int {
        usable(from + 1) ? from + 1 : usable(from + 2) ? from + 2 : usable(from + 3) ? from + 3 : -1
    }

    function above(from: int) -> int {
        usable(from - 1) ? from - 1 : usable(from - 2) ? from - 2 : usable(from - 3) ? from - 3 : -1
    }

    function go-down() {
        let target = root.below(root.focused-row);
        if target < 0 {
            sign-out.focus();
            return;
        }
        if HomeView.rows[root.focused-row].shape == CardShape.poster {
            root.posters-above += 1;
        } else {
            root.thumbs-above += 1;
        }
        root.focused-row = target;
    }

    function go-up() {
        let target = root.above(root.focused-row);
        if target < 0 {
            return;
        }
        if HomeView.rows[target].shape == CardShape.poster {
            root.posters-above -= 1;
        } else {
            root.thumbs-above -= 1;
        }
        root.focused-row = target;
    }

    function step(delta: int) {
        if !root.usable(root.focused-row) {
            return;
        }
        HomeView.rows[root.focused-row].current = clamp(
            HomeView.rows[root.focused-row].current + delta,
            0,
            HomeView.rows[root.focused-row].cards.length - 1);
    }

    function activate(row: int, index: int) {
        root.selected = HomeView.rows[row].cards[index].title;
        HomeView.card-activated(row, index);
    }

    VerticalLayout {
        padding-top: Theme.page-margin;
        padding-bottom: Theme.page-margin;
        spacing: Theme.spacing;

        HorizontalLayout {
            padding-left: Theme.page-margin;
            padding-right: Theme.page-margin;
            spacing: Theme.spacing;

            VerticalLayout {
                alignment: end;

                Text {
                    text: HomeView.server-name;
                    color: Theme.text;
                    font-size: Theme.title-size;
                    font-weight: Theme.strong-weight;
                    overflow: elide;
                }

                Text {
                    text: "Jellyfin " + HomeView.server-version;
                    color: Theme.muted;
                    font-size: Theme.label-size;
                }
            }

            VerticalLayout {
                alignment: end;

                Text {
                    text: "Signed in as " + HomeView.username;
                    color: Theme.text;
                    font-size: Theme.body-size;
                    horizontal-alignment: right;
                }

                // Always takes its line, so the rows never jump when it
                // appears.
                Text {
                    text: root.selected == "" ? "" : "Selected: " + root.selected;
                    color: Theme.muted;
                    font-size: Theme.label-size;
                    horizontal-alignment: right;
                }
            }
        }

        // The rows' window onto the page: full width, so a row runs to the
        // screen's edge, and clipped above and below so scrolled rows vanish
        // here instead of over the header.
        viewport := Rectangle {
            vertical-stretch: 1;
            min-height: Theme.poster-min-height;
            clip: true;

            scope := FocusScope {
                accessible-role: list;

                key-pressed(event) => {
                    if Keys.intent(event) == KeyIntent.left {
                        root.step(-1);
                        return accept;
                    }
                    if Keys.intent(event) == KeyIntent.right {
                        root.step(1);
                        return accept;
                    }
                    if Keys.intent(event) == KeyIntent.next {
                        root.go-down();
                        return accept;
                    }
                    if Keys.intent(event) == KeyIntent.previous {
                        root.go-up();
                        return accept;
                    }
                    if Keys.intent(event) == KeyIntent.activate {
                        if root.usable(root.focused-row) {
                            root.activate(root.focused-row, HomeView.rows[root.focused-row].current);
                        }
                        return accept;
                    }
                    if Keys.intent(event) == KeyIntent.back || Keys.intent(event) == KeyIntent.backspace {
                        HomeView.back();
                        return accept;
                    }
                    return reject;
                }
            }

            // Moved, not scrolled by a Flickable, so the anchor is exact and
            // a held D-pad retargets the slide mid-way.
            strip := VerticalLayout {
                y: Theme.home-row-anchor - root.scroll;
                width: parent.width;
                alignment: start;
                animate y {
                    duration: Theme.scroll-duration;
                    easing: ease-out;
                }

                // An empty row is never created and takes no room: its slot is
                // zero tall.
                for row[r] in HomeView.rows: Rectangle {
                    property <length> block: row.cards.length > 0 ? CarouselMetrics.height(row.shape, root.poster-height) : 0px;
                    min-height: self.block;
                    max-height: self.block;

                    if row.cards.length > 0: CarouselRow {
                        title: row.title;
                        cards: row.cards;
                        shape: row.shape;
                        poster-height: root.poster-height;
                        current: row.current;
                        focused: scope.has-focus && r == root.focused-row;
                        chosen: r == root.focused-row;
                        activated(index) => {
                            root.focused-row = r;
                            HomeView.rows[r].current = index;
                            scope.focus();
                            root.activate(r, index);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Theme.page-margin;
            padding-right: Theme.page-margin;
            spacing: Theme.spacing;

            sign-out := Button {
                width: Theme.button-width;
                text: "Sign out";
                clicked => {
                    HomeView.sign-out();
                }
                move-previous => {
                    scope.focus();
                }
                back => {
                    HomeView.back();
                }
            }

            if HomeView.notice != "": Text {
                text: HomeView.notice;
                color: Theme.muted;
                font-size: Theme.label-size;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
