export enum Screen { login, home, server-selection }

export global ServerSelectionView {
    in-out property <string> server-url;
    in-out property <string> error;

    callback submit(server-url: string);
}

export global LoginView {
    in-out property <string> username;
    in property <string> server-url;
    in property <string> server-name;

    callback submit(username: string, password: string);
    callback back();
}

export global HomeView {
    in property <string> user-name;
}
