// Tuned for a 10-foot (TV) UI, assuming a 1920x1080 logical canvas.
export global Theme {
    // Colors
    out property <color> background: #101318;
    out property <color> surface: #1b2029;
    out property <color> surface-focused: #33405a;
    out property <color> text: #e8ecf2;
    out property <color> text-muted: #aab3c0;
    out property <color> accent: #6aa8ff;
    out property <color> error: #ff7a7a;

    // Layout
    out property <length> form-width: 800px;
    out property <length> form-height: 80px;
    out property <length> form-gutter: 96px;
    out property <length> spacing: 24px;
    out property <length> padding: 20px;
    out property <length> radius: 12px;
    out property <length> focus-ring: 5px;

    // Type
    out property <length> title-size: 56px;
    out property <length> body-size: 32px;
    out property <length> label-size: 26px;
    out property <int> strong-weight: 700;
}
